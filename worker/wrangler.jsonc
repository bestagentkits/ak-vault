// ak-vault Worker configuration. Top level = production; `env.staging` = staging.
// Secrets are never stored here: set REVOCATION_WEBHOOK_SECRET (and, during a
// rotation overlap, REVOCATION_WEBHOOK_SECRET_PREVIOUS) with `wrangler secret put`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ak-vault",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  // Platform invocation logs record full URLs (raw vault/item IDs) and request
  // metadata, bypassing the operational logger contract, so only our own
  // redacted console logs are kept.
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },
  // The Worker runs first for every request so static pages get security headers too.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "routes": [{ "pattern": "vault.agentkit.best", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "VAULT", "class_name": "VaultDurableObject" },
      { "name": "REVOCATIONS", "class_name": "RevocationRegistry" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["VaultDurableObject", "RevocationRegistry"] }],
  "vars": {
    // Kill switch: production sync is on by owner decision (2026-10-16, issue #8),
    // enabled before the owner's review (accepted 2026-10-16; not an independent
    // review) and still pre-release; see docs/security/release-gates.md. Turn it off
    // with the kill switch in docs/operations/runbooks.md.
    "VAULT_SYNC_ENABLED": "true",
    "VAULT_ISSUER": "https://agentkit.best",
    "VAULT_AUDIENCE": "https://vault.agentkit.best",
    // ak-web's OAuth server JWKS (jwks_uri in /.well-known/oauth-authorization-server).
    // Its keys also sign other resources' tokens; the exact audience above keeps those out.
    "VAULT_JWKS_URL": "https://agentkit.best/.well-known/jwks.json"
  },
  "env": {
    "staging": {
      "name": "ak-vault-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "vault-staging.agentkit.best", "custom_domain": true }],
      "durable_objects": {
        "bindings": [
          { "name": "VAULT", "class_name": "VaultDurableObject" },
          { "name": "REVOCATIONS", "class_name": "RevocationRegistry" }
        ]
      },
      "vars": {
        "VAULT_SYNC_ENABLED": "true",
        // ak-web staging, which mints vault tokens at /api/agentkit/vault/token.
        "VAULT_ISSUER": "https://staging.agentkit.best",
        // Distinct from production so a token minted for one environment is refused by the other.
        "VAULT_AUDIENCE": "https://vault-staging.agentkit.best",
        // ak-web staging's JWKS; its keys are separate from production's.
        "VAULT_JWKS_URL": "https://staging.agentkit.best/.well-known/jwks.json"
      }
    }
  }
}
