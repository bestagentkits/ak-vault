{
  "version": 1,
  "description": "Portable policy (spec §8). expected = effectiveGrant(local, policy, sensitivity): ttl = min, require_approval = local OR policy OR sensitivity==\"high\", projects/purposes = local filtered by allowed_* (absent = unchanged), agents = local minus deny_agents. The result is always a subset of local; text fields (description, when_to_use, urls) are inert. policy null = no policy. invalid: unknown fields or wrong types MUST be rejected with expect_error (caller denies).",
  "cases": [
    {
      "name": "no_policy",
      "local": {
        "ttl_s": 3600,
        "require_approval": false,
        "projects": [
          "proj_a",
          "proj_b"
        ],
        "purposes": [
          "deploy",
          "test"
        ],
        "agents": [
          "claude",
          "codex"
        ]
      },
      "policy": null,
      "sensitivity": "normal",
      "expected": {
        "ttl_s": 3600,
        "require_approval": false,
        "projects": [
          "proj_a",
          "proj_b"
        ],
        "purposes": [
          "deploy",
          "test"
        ],
        "agents": [
          "claude",
          "codex"
        ]
      }
    },
    {
      "name": "no_policy_high_sensitivity_requires_approval",
      "local": {
        "ttl_s": 3600,
        "require_approval": false,
        "projects": [
          "proj_a",
          "proj_b"
        ],
        "purposes": [
          "deploy",
          "test"
        ],
        "agents": [
          "claude",
          "codex"
        ]
      },
      "policy": null,
      "sensitivity": "high",
      "expected": {
        "ttl_s": 3600,
        "require_approval": true,
        "projects": [
          "proj_a",
          "proj_b"
        ],
        "purposes": [
          "deploy",
          "test"
        ],
        "agents": [
          "claude",
          "codex"
        ]
      }
    },
