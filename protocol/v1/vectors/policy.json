          "deploy",
          "test"
        ],
        "agents": [
          "claude",
          "codex"
        ]
      },
      "policy": {
        "max_ttl_s": 600,
        "allowed_projects": [
          "proj_a"
        ],
        "deny_agents": [
          "codex"
